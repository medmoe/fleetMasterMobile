{
  "expo": {
    "name": "fleetmaster",
    "slug": "fleetmaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fleetmaster",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medse.fleetmaster",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.medse.fleetmaster"
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "14540b51-1138-4bb5-aa86-a846bd5514ec"
      }
    }
  }
}
